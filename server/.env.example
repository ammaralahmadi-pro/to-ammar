# قاعدة البيانات (PostgreSQL) — يمكن استخدام Neon / Supabase / Railway مجانًا
DATABASE_URL="postgresql://user:password@localhost:5432/family_calendar"

# Google OAuth 2.0 — من Google Cloud Console (نفس المشروع الذي فعّلت فيه Google Calendar API)
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxxxxx"
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/callback"

# البريدان الإلكترونيان المسموح لهما بتسجيل الدخول (العائلة فقط)، مفصولان بفاصلة
ALLOWED_EMAILS="you@gmail.com,spouse@gmail.com"

# مفاتيح سرّية — ولّدها بأمر: openssl rand -hex 32
JWT_SECRET="replace-with-64-hex-chars"
TOKEN_ENCRYPTION_KEY="replace-with-64-hex-chars"

# روابط
FRONTEND_URL="http://localhost:3000"
PORT=4000
NODE_ENV="development"
