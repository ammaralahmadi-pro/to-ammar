# --- قاعدة البيانات (Azure SQL) ---
DATABASE_URL="sqlserver://<server>.database.windows.net:1433;database=<db>;user=<user>;password=<password>;encrypt=true"

# --- Microsoft Entra ID (للتحقق من التوكن الوارد من البوت/الواجهة) ---
ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"
ENTRA_API_CLIENT_ID="00000000-0000-0000-0000-000000000000"   # Application ID URI للـ API نفسه

# --- Microsoft Graph (Client Credentials — للإشعارات التلقائية) ---
GRAPH_TENANT_ID="00000000-0000-0000-0000-000000000000"
GRAPH_CLIENT_ID="00000000-0000-0000-0000-000000000000"
GRAPH_CLIENT_SECRET="__________________________"

PORT=3000
