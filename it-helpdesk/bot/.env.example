# --- تسجيل البوت في Azure Bot Service ---
MicrosoftAppType=MultiTenant
MicrosoftAppId="00000000-0000-0000-0000-000000000000"
MicrosoftAppPassword="__________________________"
MicrosoftAppTenantId="00000000-0000-0000-0000-000000000000"

# اسم اتصال الـ OAuth الذي أنشأته في إعدادات قناة Teams بالبوت (SSO)
# يجب أن يشير هذا الاتصال إلى تطبيق الـ API (نفس Application ID URI في api/.env)
OAUTH_CONNECTION_NAME="HelpdeskSSO"

# رابط الـ API (المشروع الآخر في هذا المستودع)
API_BASE_URL="http://localhost:3000"

PORT=3978
