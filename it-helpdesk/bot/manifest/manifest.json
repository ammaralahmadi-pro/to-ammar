{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "packageName": "com.company.helpdesk",
  "developer": {
    "name": "IT Department",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "name": {
    "short": "الدعم الفني",
    "full": "نظام الدعم الفني الداخلي"
  },
  "description": {
    "short": "افتح وتابع تذاكر الدعم الفني مباشرة من Teams",
    "full": "بوت لفتح تذاكر الدعم الفني ومتابعتها داخل مايكروسوفت تيمز، مع تسجيل دخول موحّد بدون كلمة مرور."
  },
  "icons": { "outline": "outline.png", "color": "color.png" },
  "accentColor": "#1E6E64",
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000000",
      "scopes": ["personal"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "webApplicationInfo": {
    "id": "00000000-0000-0000-0000-000000000000",
    "resource": "api://<your-domain>/<api-client-id>"
  },
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["token.botframework.com"]
}
