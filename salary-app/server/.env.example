DATABASE_URL="postgresql://user:password@localhost:5432/salary_app"
PORT=4100
NODE_ENV=development
FRONTEND_URL="http://localhost:3100"
JWT_SECRET="generate-with-openssl-rand-hex-32"

# نفس بيانات مشروع Google Cloud المستخدم لتطبيق "مواعيدنا" يمكن إعادة استخدامها هنا —
# فقط أضف رابط الاستدعاء (Authorized redirect URI) الجديد الخاص بهذا الخادم:
# <رابط-الخادم>/auth/google/callback
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4100/auth/google/callback"

# البريد أو البُرد الإلكترونية المسموح لها بتسجيل الدخول، مفصولة بفواصل
ALLOWED_EMAILS="you@example.com"
